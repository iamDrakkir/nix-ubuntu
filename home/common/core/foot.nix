{ config, homeDirectory, ... }:

{
  programs.foot = {
    enable = true;

    settings = {
      main = {
        # Theme is auto-generated by noctalia-shell
        include = "~/.config/foot/themes/noctalia";
        
        # Font configuration
        font = "monospace:size=10";
        
        # Window configuration
        pad = "4x4";
      };

      mouse = {
        hide-when-typing = "yes";
      };

      cursor = {
        style = "block";
        blink = "no";
      };

      scrollback = {
        lines = 10000;
      };
    };
  };
}
